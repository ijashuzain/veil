[Unit]
Description=Veil authenticated web player resolver and stream proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
Group=www-data
WorkingDirectory=/opt/veil-player
ExecStart=/usr/bin/node /opt/veil-player/server.mjs
EnvironmentFile=/etc/veil-player/backend.env
Environment=SOCKET_PATH=/run/veil-player/service.sock
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/veil-player-pilot/browsers
Environment=LD_LIBRARY_PATH=/opt/veil-player-pilot/libs/usr/lib/x86_64-linux-gnu
RuntimeDirectory=veil-player
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=5
MemoryMax=700M
MemorySwapMax=0
CPUQuota=60%
TasksMax=160
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=169.254.0.0/16
IPAddressDeny=127.0.0.0/8
IPAddressAllow=127.0.0.53/32
IPAddressAllow=127.0.0.54/32
IPAddressDeny=::1/128
IPAddressDeny=fc00::/7

[Install]
WantedBy=multi-user.target
